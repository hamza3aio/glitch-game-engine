{
  "name": "glitch-game-engine",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Glitch Game Engine: minimal 3D web game engine with loop, WebGL2 rendering, ECS, physics, input, audio.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "electron:dev": "npm run build && electron .",
    "dist:exe": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.glitch.engine",
    "productName": "Glitch Game Engine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "project-template/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
